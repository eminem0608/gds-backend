# Replace demo.example.com and /srv/craft-brew-demo with actual values.
# Add this as a separate virtual host; keep the existing site's config intact.
server {
    listen 80;
    server_name demo.example.com;
    root /srv/craft-brew-demo/h5/dist;
    index index.html;
    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://127.0.0.1:18069;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
