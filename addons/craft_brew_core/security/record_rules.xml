<odoo>
    <record id="rule_brew_api_session_company" model="ir.rule">
        <field name="name">API 会话：企业范围</field>
        <field name="model_id" ref="model_brew_api_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_brew_admin'))]"/>
    </record>

    <record id="rule_brew_audit_log_company" model="ir.rule">
        <field name="name">审计日志：企业范围</field>
        <field name="model_id" ref="model_brew_audit_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_brew_admin'))]"/>
    </record>

    <record id="rule_brew_outbox_event_company" model="ir.rule">
        <field name="name">Outbox：企业范围</field>
        <field name="model_id" ref="model_brew_outbox_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_brew_admin'))]"/>
    </record>
</odoo>
