<odoo>
    <record id="module_category_craft_brew" model="ir.module.category">
        <field name="name">Craft Beer SaaS</field>
        <field name="description">精酿啤酒 SaaS 系统权限</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_brew_general_manager" model="res.groups">
        <field name="name">总经理</field>
        <field name="category_id" ref="module_category_craft_brew"/>
    </record>

    <record id="group_brew_production_director" model="res.groups">
        <field name="name">生产总监</field>
        <field name="category_id" ref="module_category_craft_brew"/>
    </record>

    <record id="group_brew_brewer" model="res.groups">
        <field name="name">酿酒师</field>
        <field name="category_id" ref="module_category_craft_brew"/>
    </record>

    <record id="group_brew_operator" model="res.groups">
        <field name="name">操作工</field>
        <field name="category_id" ref="module_category_craft_brew"/>
    </record>

    <record id="group_brew_warehouse" model="res.groups">
        <field name="name">库管</field>
        <field name="category_id" ref="module_category_craft_brew"/>
    </record>

    <record id="group_brew_purchase" model="res.groups">
        <field name="name">采购</field>
        <field name="category_id" ref="module_category_craft_brew"/>
    </record>

    <record id="group_brew_sales" model="res.groups">
        <field name="name">销售</field>
        <field name="category_id" ref="module_category_craft_brew"/>
    </record>

    <record id="group_brew_finance" model="res.groups">
        <field name="name">财务</field>
        <field name="category_id" ref="module_category_craft_brew"/>
    </record>

    <record id="group_brew_admin" model="res.groups">
        <field name="name">系统管理员</field>
        <field name="category_id" ref="module_category_craft_brew"/>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
