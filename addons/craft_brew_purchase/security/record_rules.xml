<odoo>
    <record id="rule_brew_purchase_requisition_scope" model="ir.rule">
        <field name="name">采购需求：企业与厂区范围</field>
        <field name="model_id" ref="model_brew_purchase_requisition"/>
        <field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('factory_id','in',user.brew_factory_ids.ids)]</field>
        <field name="groups" eval="[(4,ref('base.group_user'))]"/>
    </record>
    <record id="rule_brew_purchase_requisition_line_company" model="ir.rule"><field name="name">采购需求明细：企业范围</field><field name="model_id" ref="model_brew_purchase_requisition_line"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('requisition_id.factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_purchase_allocation_company" model="ir.rule"><field name="name">采购来源分配：企业范围</field><field name="model_id" ref="model_brew_purchase_requisition_allocation"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('requisition_line_id.requisition_id.factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_supplier_shipment_scope" model="ir.rule"><field name="name">供应商发货：企业与厂区范围</field><field name="model_id" ref="model_brew_supplier_shipment"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_supplier_shipment_line_company" model="ir.rule"><field name="name">供应商发货明细：企业范围</field><field name="model_id" ref="model_brew_supplier_shipment_line"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_receipt_scope" model="ir.rule"><field name="name">采购收货：企业与厂区范围</field><field name="model_id" ref="model_brew_receipt"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_receipt_line_company" model="ir.rule"><field name="name">采购收货明细：企业范围</field><field name="model_id" ref="model_brew_receipt_line"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_quality_scope" model="ir.rule"><field name="name">来料质检：企业与厂区范围</field><field name="model_id" ref="model_brew_quality_inspection"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_quality_line_company" model="ir.rule"><field name="name">来料质检明细：企业范围</field><field name="model_id" ref="model_brew_quality_inspection_line"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
</odoo>
