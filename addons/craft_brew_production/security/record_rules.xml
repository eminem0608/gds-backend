<odoo>
    <record id="rule_brew_material_requisition_scope" model="ir.rule"><field name="name">领料单：企业与厂区范围</field><field name="model_id" ref="model_brew_material_requisition"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_material_requisition_line_company" model="ir.rule"><field name="name">领料明细：企业范围</field><field name="model_id" ref="model_brew_material_requisition_line"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_material_allocation_company" model="ir.rule"><field name="name">领料批次：企业范围</field><field name="model_id" ref="model_brew_material_requisition_allocation"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_production_batch_scope" model="ir.rule"><field name="name">生产批次：企业与厂区范围</field><field name="model_id" ref="model_brew_production_batch"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_production_record_scope" model="ir.rule"><field name="name">生产记录：企业范围</field><field name="model_id" ref="model_brew_production_record"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_production_actual_company" model="ir.rule"><field name="name">实际物料：企业范围</field><field name="model_id" ref="model_brew_production_material_actual"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
</odoo>
