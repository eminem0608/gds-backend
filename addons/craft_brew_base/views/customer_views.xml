<odoo>
    <record id="view_brew_customer_tree" model="ir.ui.view">
        <field name="name">brew.customer.tree</field>
        <field name="model">brew.customer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="contact_name"/>
                <field name="phone"/>
                <field name="customer_level"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_brew_customer_form" model="ir.ui.view">
        <field name="name">brew.customer.form</field>
        <field name="model">brew.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <field name="name"/>
                        <field name="contact_name"/>
                        <field name="phone"/>
                        <field name="delivery_address"/>
                        <field name="customer_level"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_brew_customer" model="ir.actions.act_window">
        <field name="name">客户管理</field>
        <field name="res_model">brew.customer</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
