<odoo>
    <record id="view_brew_factory_tree" model="ir.ui.view">
        <field name="name">brew.factory.tree</field>
        <field name="model">brew.factory</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="address"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_brew_factory_form" model="ir.ui.view">
        <field name="name">brew.factory.form</field>
        <field name="model">brew.factory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="manager_id"/>
                        <field name="address"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_brew_factory" model="ir.actions.act_window">
        <field name="name">厂区管理</field>
        <field name="res_model">brew.factory</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
