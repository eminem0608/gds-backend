<odoo>
    <record id="view_brew_warehouse_tree" model="ir.ui.view">
        <field name="name">brew.warehouse.tree</field>
        <field name="model">brew.warehouse</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="factory_id"/>
                <field name="warehouse_type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_brew_warehouse_form" model="ir.ui.view">
        <field name="name">brew.warehouse.form</field>
        <field name="model">brew.warehouse</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <field name="name"/>
                        <field name="factory_id"/>
                        <field name="warehouse_type"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_brew_warehouse" model="ir.actions.act_window">
        <field name="name">仓库管理</field>
        <field name="res_model">brew.warehouse</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
