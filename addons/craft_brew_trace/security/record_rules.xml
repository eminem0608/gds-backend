<odoo>
    <record id="rule_brew_packaging_order_scope" model="ir.rule"><field name="name">Packaging orders: scope</field><field name="model_id" ref="model_brew_packaging_order"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_packaging_material_company" model="ir.rule"><field name="name">Packaging material lines: company</field><field name="model_id" ref="model_brew_packaging_material_line"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_trace_code_scope" model="ir.rule"><field name="name">Trace codes: scope</field><field name="model_id" ref="model_brew_trace_code"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_outbound_order_scope" model="ir.rule"><field name="name">Outbound orders: scope</field><field name="model_id" ref="model_brew_outbound_order"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_outbound_line_company" model="ir.rule"><field name="name">Outbound lines: company</field><field name="model_id" ref="model_brew_outbound_order_line"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
</odoo>
