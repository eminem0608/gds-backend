<odoo noupdate="1">
    <record id="seq_brew_packaging_order" model="ir.sequence"><field name="name">Packaging Order</field><field name="code">brew.packaging.order</field><field name="prefix">PKG/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
    <record id="seq_brew_finished_lot" model="ir.sequence"><field name="name">Finished Beer Lot</field><field name="code">brew.finished.lot</field><field name="prefix">FB/%(year)s%(month)s%(day)s/</field><field name="padding">4</field><field name="company_id" eval="False"/></record>
    <record id="seq_brew_trace_code" model="ir.sequence"><field name="name">Trace Code</field><field name="code">brew.trace.code</field><field name="padding">10</field><field name="company_id" eval="False"/></record>
    <record id="seq_brew_outbound_order" model="ir.sequence"><field name="name">Outbound Order</field><field name="code">brew.outbound.order</field><field name="prefix">OUT/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
</odoo>
