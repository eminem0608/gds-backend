<odoo>
    <record id="rule_brew_approval_instance_company" model="ir.rule">
        <field name="name">审批实例：企业范围</field><field name="model_id" ref="model_brew_approval_instance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_brew_approval_step_company" model="ir.rule">
        <field name="name">审批步骤：企业范围</field><field name="model_id" ref="model_brew_approval_step"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_brew_task_scope" model="ir.rule">
        <field name="name">统一任务：企业与本人范围</field><field name="model_id" ref="model_brew_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') or user.has_group('craft_brew_core.group_brew_production_director') else [('company_id', 'in', company_ids), '|', ('assignee_id', '=', user.id), ('assignee_id', '=', False)]</field><field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
