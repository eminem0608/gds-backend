<odoo>
    <record id="rule_brew_export_job_own" model="ir.rule"><field name="name">Export jobs: own company and requester</field><field name="model_id" ref="model_brew_export_job"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('requested_by_id','=',user.id)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_notification_preference_own" model="ir.rule"><field name="name">Notification preferences: own</field><field name="model_id" ref="model_brew_notification_preference"/><field name="domain_force">[('user_id','=',user.id),('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_notification_own" model="ir.rule"><field name="name">Notifications: own</field><field name="model_id" ref="model_brew_notification"/><field name="domain_force">[('user_id','=',user.id),('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
</odoo>
