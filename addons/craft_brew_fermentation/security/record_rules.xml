<odoo>
    <record id="rule_brew_fermentation_session_scope" model="ir.rule"><field name="name">发酵会话：企业与厂区范围</field><field name="model_id" ref="model_brew_fermentation_session"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_fermentation_node_company" model="ir.rule"><field name="name">发酵节点：企业范围</field><field name="model_id" ref="model_brew_fermentation_node"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_fermentation_action_company" model="ir.rule"><field name="name">发酵动作：企业范围</field><field name="model_id" ref="model_brew_fermentation_action"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_fermentation_reading_company" model="ir.rule"><field name="name">发酵读数：企业范围</field><field name="model_id" ref="model_brew_fermentation_reading"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
    <record id="rule_brew_production_anomaly_scope" model="ir.rule"><field name="name">生产异常：企业与厂区范围</field><field name="model_id" ref="model_brew_production_anomaly"/><field name="domain_force">[('company_id','in',company_ids)] if user.has_group('craft_brew_core.group_brew_admin') or user.has_group('craft_brew_core.group_brew_general_manager') else [('company_id','in',company_ids),('factory_id','in',user.brew_factory_ids.ids)]</field><field name="groups" eval="[(4,ref('base.group_user'))]"/></record>
</odoo>
